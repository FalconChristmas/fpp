#!/bin/bash
# This script is executed by Apache when the "/git" URL is hit
# Ths only purpose is to call git-http-backend, but as root
# as /opt/fpp is root:root and Apache runs as fpp. 
# "$@", quoted: Apache passes a query string with no "=" as argv words,
# and an unquoted $@ would also glob-expand them, as root.
sudo -E /usr/lib/git-core/git-http-backend "$@"
