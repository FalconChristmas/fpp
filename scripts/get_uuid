#!/bin/bash
#
# Prints a stable system identifier on stdout.
#
# Usage:
#   get_uuid            print the UUID
#   get_uuid --source   print the token naming which method produced it
#
# Each method below is a candidate only.  A candidate that does not pass
# uuid_valid() is discarded and the chain continues to the next method --
# a bad value must never be emitted, because a duplicated identifier is far
# worse than a locally generated random one.  The final method always
# succeeds, so the chain never runs out.
#

WANT_SOURCE=0
if [ "$1" = "--source" ] || [ "$1" = "-s" ]; then
    WANT_SOURCE=1
fi

WANT_REGEN=0
if [ "$1" = "--regenerate" ] || [ "$1" = "-r" ]; then
    WANT_REGEN=1
fi

emit() {
    # emit <uuid> <source>
    if [ "$WANT_SOURCE" = "1" ]; then
        echo "$2"
    else
        echo "$1"
    fi
    exit 0
}

#
# Values seen on large numbers of unrelated installs: shared vendor defaults,
# dmidecode placeholders, and the usual all-zero/all-f serials.  Compared
# case-insensitively against the bare value, without the M<n>- prefix.
#
# The two truncated PocketBeagle serials here are already rejected by the
# shape check in uuid_valid(); they are listed as well only so that the
# specific values known to be catastrophically shared cannot come back if
# the shape rules are ever relaxed.
#
UUID_DENYLIST="
1741gpb4
1741gpb2
123456789
1234567890
0123456789
serial
serialnumber
systemserialnumber
notspecified
not
specified
none
null
nil
unknown
default
defaultstring
tobefilledbyoem
to
be
filled
by
oem
n/a
na
invalid
0
00000000-0000-0000-0000-000000000000
ffffffff-ffff-ffff-ffff-ffffffffffff
"

#
# A candidate is usable only if it is a single whitespace-free token of at
# least 6 characters that is not all zeros/f's and is not denylisted.
# The whitespace test is what rejects "Not Specified" as a whole rather than
# silently truncating it to "Not".
#
uuid_valid() {
    local v="$1"

    [ -z "$v" ] && return 1

    # Any whitespace (including an embedded newline from a multi-line grep)
    case "$v" in
        *[[:space:]]*) return 1 ;;
    esac

    # Too short to plausibly be unique
    [ "${#v}" -lt 6 ] && return 1

    # All zeros, or all f's, ignoring separators
    local stripped
    stripped=$(echo "$v" | tr -d -- '-:_' | tr 'A-Z' 'a-z')
    case "$stripped" in
        *[!0]*) ;;
        *) return 1 ;;
    esac
    case "$stripped" in
        *[!f]*) ;;
        *) return 1 ;;
    esac

    #
    # Per-family shape check.  BeagleBoard-family serials are a 4-digit date
    # code, a board code, then a sequence -- 3116BBBK023C, 1741GPB30297.  A
    # serial truncated by the flashing tool keeps a valid-looking prefix and
    # loses the tail, so the duplicates it creates are visible in the shape
    # long before anyone notices the value.  Two such values account for a
    # third of all hosts sharing a hardware serial, and both are the only
    # malformed members of an otherwise well-formed family.  Check the shape
    # rather than chasing individual values: a real sequence is at least four
    # characters, and exactly five digits in the GPB (PocketBeagle) family.
    #
    local upper
    upper=$(echo "$v" | tr 'a-z' 'A-Z')
    if [[ "$upper" =~ ^[0-9]{4}([A-Z]+)([0-9A-Z]*)$ ]]; then
        local board="${BASH_REMATCH[1]}"
        local seq="${BASH_REMATCH[2]}"
        if [ "${#seq}" -lt 4 ]; then
            return 1
        fi
        if [ "$board" = "GPB" ] && ! [[ "$seq" =~ ^[0-9]{5}$ ]]; then
            return 1
        fi
    fi

    local lower
    lower=$(echo "$v" | tr 'A-Z' 'a-z')
    local bad
    for bad in $UUID_DENYLIST; do
        if [ "$lower" = "$bad" ]; then
            return 1
        fi
    done

    return 0
}


#
# --regenerate: replace this board's identity with a new one.
#
# Called by fppd when MultiSync sees another device advertising our UUID (see
# MultiSync::CheckForDuplicateUUID).  The source that is winning right now
# decides what "replace" can mean, and this only performs the change that
# source allows:
#
#   generated / container   drop the stored value; the normal path below then
#                           makes a new one and persists it as usual
#   setting                 rewrite the FPP_UUID override in the media settings
#                           file, which fppd re-reads when it changes
#   anything else           refuse with exit 3.  cpuinfo, device-tree, board
#                           EEPROM and dmidecode values are burned into the
#                           hardware, and machine-id is not ours to rewrite from
#                           here -- a board whose identity comes from those
#                           needs an override, and that is its owner's decision.
#
# Nothing extra is printed: the normal path emits the new value (and --source
# its token), so callers parse the output exactly as they do today.
#
if [ "$WANT_REGEN" = "1" ]; then
    REGEN_SRC=$("$0" --source)
    case "$REGEN_SRC" in
        generated|container)
            sudo rm -f "${FPP_UUIDFILE:-/etc/fpp/fpp_uuid}" "${FPP_UUIDMEDIAFILE:-/home/fpp/media/config/fpp_uuid}" 2>/dev/null
            rm -f /tmp/fpp_uuid /tmp/fpp_uuid_source 2>/dev/null
            ;;
        setting)
            REGEN_SETTINGS=/home/fpp/media/settings
            REGEN_NEW="$(tr -d '\0' </proc/sys/kernel/random/uuid | tr -d '[:space:]' | tr 'a-z' 'A-Z')"
            REGEN_TMP=$(mktemp)
            sed -e "0,/^FPP_UUID.*/s//FPP_UUID = ${REGEN_NEW}/" "$REGEN_SETTINGS" > "$REGEN_TMP"
            # tee truncates in place, so the file keeps its owner and mode
            if ! sudo tee "$REGEN_SETTINGS" < "$REGEN_TMP" >/dev/null; then
                rm -f "$REGEN_TMP"
                echo "get_uuid: could not rewrite FPP_UUID in $REGEN_SETTINGS" >&2
                exit 3
            fi
            rm -f "$REGEN_TMP" /tmp/fpp_uuid /tmp/fpp_uuid_source 2>/dev/null
            ;;
        *)
            echo "get_uuid: cannot regenerate: identity comes from '$REGEN_SRC'" >&2
            exit 3
            ;;
    esac
    # fall through: the chain re-derives and re-persists the value
fi

PLATFORM=$(uname);

if [ "$PLATFORM" = "Darwin" ]; then
    PATH=$PATH:/usr/sbin:/sbin:/opt/homebrew/bin:/opt/homebrew/sbin:
    UUID=$(ioreg -d2 -c IOPlatformExpertDevice | awk -F\" '/IOPlatformUUID/{print $(NF-1)}')
    if uuid_valid "$UUID"; then
        emit "$UUID" "ioreg"
    fi
    emit "Unknown" "none"
fi


#
# Check for a developer-only FPP_UUID setting
#
if [ -f /home/fpp/media/settings ]; then
    UUID=$(grep "^FPP_UUID" /home/fpp/media/settings | cut -f2 -d= | sed -e "s/[^-A-Za-z0-9]//g")
    if [ "$UUID" != "" ]; then
        emit "$UUID" "setting"
    fi
fi

#
# Container detection.
#
# In a container every hardware identity source describes the HOST, not this
# instance: /proc/cpuinfo, the device tree and dmidecode are all the host's, so
# two containers on one machine -- or a container and the host's own FPP --
# would report the same identity.  /etc/machine-id is worse: it comes from an
# image layer, so every container ever started from that image is born with the
# same one, which is where most machine-id collisions in the wild come from.
#
# So a container's identity has to come from its own persistent state.  The only
# thing that survives `docker compose up --force-recreate` is the media volume
# (see Docker/docker-compose.yml, which mounts ./media:/home/fpp/media) -- /etc
# lives in the container's writable layer and is discarded with it.  Hence the
# jump straight to the generated UUID below, which is kept in the media dir.
#
# /etc/fpp/container is what FPPINIT already keys container behaviour off (see
# checkHostName() in src/boot/FPPINIT_Config.cpp); /.dockerenv and
# /run/.containerenv cover docker and podman when that marker is absent.
# The two paths are overridable so this path can be tested; nothing sets them.
#
DOCKERENV=${FPP_DOCKERENV:-/.dockerenv}
CONTAINERFILE=${FPP_CONTAINERFILE:-/etc/fpp/container}
IN_CONTAINER=n
if [ -f "$DOCKERENV" ] || [ -f "$CONTAINERFILE" ] || [ -f /run/.containerenv ]; then
    IN_CONTAINER=y
fi

if [ "$IN_CONTAINER" != "y" ]; then

#
# Try and use CPUInfo -- works on PI and BBB
#
UUID=$(grep -i serial /proc/cpuinfo | head -1 | awk '{ print $3}')
if uuid_valid "$UUID"; then
    emit "M1-$UUID" "cpuinfo"
fi

if [ -f "/proc/device-tree/serial-number" ]; then
    UUID=$(tr -d '\0' </proc/device-tree/serial-number)
    if uuid_valid "$UUID"; then
        emit "M3-$UUID" "device-tree"
    fi
fi

#
# The board's own EEPROM.  i2c bus 0 at 0x50 is the Beagle itself -- a cape
# EEPROM lives at 0x50 on bus 1 or 2 instead -- so this serial belongs to the
# board and stays with it when a cape is swapped.
#
if [ -f "/sys/bus/i2c/devices/0-0050/eeprom" ]; then
    sn=$(dd if=/sys/bus/i2c/devices/0-0050/eeprom count=16 skip=40 bs=1 2>/dev/null || true)
    if [[ "$sn" =~ ^[0-9]*PB[0-9A-FI]*$ ]] && uuid_valid "$sn"; then
        emit "M5-$sn" "board-eeprom"
    fi
fi


#
# Try dmidecode.  Take everything after the colon rather than a single awk
# field so that a multi-word placeholder stays multi-word and is rejected by
# uuid_valid() instead of being truncated into something that looks valid.
#
if [[ -f /sbin/dmidecode  || -f /usr/sbin/dmidecode ]]; then
    DMI=$(sudo dmidecode 2>/dev/null)
    UUID=$(echo "$DMI" | grep -i 'serial number' | head -1 | sed -e 's/^[^:]*:[[:space:]]*//' -e 's/[[:space:]]*$//')
    if ! uuid_valid "$UUID"; then
        UUID=$(echo "$DMI" | grep -i 'uuid' | head -1 | sed -e 's/^[^:]*:[[:space:]]*//' -e 's/[[:space:]]*$//')
    fi
    if uuid_valid "$UUID"; then
        emit "M2-$UUID" "dmidecode"
    fi
fi

#
# systemd's machine-id is deliberately NOT an identity source any more.
#
# It was one (M4-), on the theory that a unique fallback beats no fallback.
# The value is unique per INSTALL, not per board: it is baked into an image,
# cloned with the card, and -- because SD/upgradeOS-part2.sh saves and restores
# it -- carried across an in-place OS upgrade.  So every board flashed from one
# image shares it, and the shared value outlives any attempt to fix it.  That is
# the whole of the duplicate-UUID class: three unrelated controllers on one show
# reporting the same M4- value, xLights marking one of them unavailable, and FPP
# Connect failing until somebody overrides the setting by hand.
#
# A candidate that cannot be unique by construction is worse than the generated
# value below, which cannot collide at all -- so the chain now goes straight
# from the hardware sources to that.  machine-id stays available to whoever
# wants it as a diagnostic; it is just not an identity.
#
fi   # end of the host-hardware branches, skipped in a container

#
# No source could prove uniqueness, so generate one and persist it.
#
# Random gives 122 bits, which cannot collide.  Persisting is what makes it
# stable; the risk is that a card snapshot, a backup restore or a container
# image carries the file to a different board, and a copied identity is exactly
# what this script exists to avoid.  So what is stored is the UUID AND a
# fingerprint of the things a card cannot copy -- the SoC serial in the device
# tree and the MAC of every non-gadget interface.  If the two disagree, the file
# was not written on this hardware and this board makes its own identity instead
# of inheriting its neighbour's.
#
# A record with no fingerprint at all is not reused either: "generate once" is
# only a guarantee if the file cannot be copied, and provenance that cannot be
# checked is treated as provenance that is wrong.
#
# Kept in two places: /etc/fpp/fpp_uuid is canonical and is saved/restored
# across an OS upgrade the same way machine-id is.  The copy under the media
# directory covers the upgrade paths that hand control to an OLDER
# upgradeOS-part2.sh (the keepOptFPP and downgrade branches in part1), which
# predates that save/restore and would drop the file.  Either copy is enough.
#
UUIDFILE=${FPP_UUIDFILE:-/etc/fpp/fpp_uuid}
UUIDMEDIAFILE=${FPP_UUIDMEDIAFILE:-/home/fpp/media/config/fpp_uuid}

# A digest of the board, not of the install.  Gadget interfaces are excluded:
# their MAC is generated per boot, so including one would make the fingerprint
# -- and with it the identity -- change on every reboot.
UUID_FP=""
FP_PARTS=""
for f in /proc/device-tree/serial-number /proc/device-tree/model; do
    [ -r "$f" ] && FP_PARTS="${FP_PARTS}$(tr -d '\0' <"$f" | tr -d '[:space:]')"
done
for f in /sys/class/net/*/address; do
    [ -r "$f" ] || continue
    case "$f" in
        */usb*/address|*/lo/address) continue ;;
    esac
    FP_PARTS="${FP_PARTS}$(tr -d ':' <"$f")"
done
if [ -n "$FP_PARTS" ]; then
    UUID_FP=$(printf '%s' "$FP_PARTS" | sha256sum | cut -c1-16)
fi

# Reads one stored record into SU_UUID / SU_FP.  A record written before the
# fingerprint existed has no second field, which reads as unknown provenance.
read_uuid_file() {
    SU_UUID=""
    SU_FP=""
    [ -f "$1" ] || return 1
    read -r SU_UUID SU_FP < "$1" || true
    [ -n "$SU_UUID" ] || return 1
    return 0
}

# Prefer the canonical copy; fall back to the media one if it was lost.
#
# A record is adopted only when it names this hardware.  Two cases are not that:
# a record whose fingerprint disagrees with this board (a copied file), and a
# record with no fingerprint on a board where one can be computed (written by an
# older get_uuid, so its provenance is unknown).  Both regenerate rather than
# inherit.  On hardware where no fingerprint can be computed at all there is
# nothing to compare, so a valid record is adopted -- the alternative would be
# churning the identity on every boot of a board that cannot tell us apart from
# a copy of itself.
UUID=""
UNCERTAIN=n
for f in "$UUIDFILE" "$UUIDMEDIAFILE"; do
    read_uuid_file "$f" || continue
    uuid_valid "$SU_UUID" || continue
    if [ -z "$UUID_FP" ] || [ "$SU_FP" = "$UUID_FP" ]; then
        UUID="$SU_UUID"
        break
    fi
    UNCERTAIN=y
done

if [ "$UNCERTAIN" = "y" ] && [ -z "$UUID" ]; then
    echo "get_uuid: stored UUID was not written on this hardware (or has no provenance); generating a new one" >&2
fi

if [ -z "$UUID" ]; then
    UUID=$(tr -d '\0' </proc/sys/kernel/random/uuid | head -1)
    uuid_valid "$UUID" || UUID=""
fi

if [ -n "$UUID" ]; then
    if [ -n "$UUID_FP" ]; then
        RECORD="$UUID $UUID_FP"
    else
        RECORD="$UUID"
    fi
    # Canonical copy first; /etc/fpp is root-owned, hence sudo.
    if [ "$(cat "$UUIDFILE" 2>/dev/null)" != "$RECORD" ]; then
        sudo mkdir -p "$(dirname "$UUIDFILE")" 2>/dev/null
        if ! echo "$RECORD" | sudo tee "$UUIDFILE" >/dev/null 2>&1; then
            echo "get_uuid: could not write $UUIDFILE" >&2
        fi
        sudo chmod 644 "$UUIDFILE" 2>/dev/null
    fi
    # Keep the media copy in step.  It is what survives an upgrade run by an
    # older upgradeOS-part2.sh, and in a container it is the ONLY copy that
    # survives the container being recreated -- so create the directory rather
    # than skipping the mirror when it is not there yet.
    MEDIADIR=$(dirname "$UUIDMEDIAFILE")
    if [ ! -d "$MEDIADIR" ] && [ -d "$(dirname "$MEDIADIR")" ]; then
        mkdir -p "$MEDIADIR" 2>/dev/null || sudo mkdir -p "$MEDIADIR" 2>/dev/null
    fi
    if [ -d "$MEDIADIR" ] && [ "$(cat "$UUIDMEDIAFILE" 2>/dev/null)" != "$RECORD" ]; then
        echo "$RECORD" > "$UUIDMEDIAFILE" 2>/dev/null || true
    fi
    if [ "$IN_CONTAINER" = "y" ]; then
        emit "$UUID" "container"
    fi
    emit "$UUID" "generated"
fi

emit "Unknown" "none"
