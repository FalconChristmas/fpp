#!/bin/bash

BINDIR=$(cd $(dirname $0) && pwd)

. ${BINDIR}/common
. ${BINDIR}/functions

# Ensure git's "dubious ownership" guard doesn't trip when running git as
# root via sudo against /opt/fpp (owned by fpp:fpp). FPP_Install.sh sets
# this system-wide already, but be defensive in case an old install is
# missing it -- otherwise the very first git call below fails before we
# get a chance to recover.
# Kept ahead of startUpgradeLog so the branch lookup below cannot trip the same
# guard; both lines are silenced anyway, so nothing is lost by not logging them.
$SUDO git config --system --add safe.directory /opt/fpp 2>/dev/null || true
$SUDO git config --system --add safe.directory '*' 2>/dev/null || true

# Unified upgrade logging -> logs/fpp_system_upgrades.log. Labelling the run with the
# branch is best-effort: a detached or unreadable checkout logs as "unknown"
# rather than holding up the update.
startUpgradeLog "fpp-update" "$(cd ${FPPDIR} 2>/dev/null && $SUDO git rev-parse --abbrev-ref HEAD 2>/dev/null || echo unknown)"

SOURCEIP=$(getSetting UpgradeSource)
if [ "x${SOURCEIP}" == "x" ]; then
    SOURCEIP=github.com
fi

HTTPURL="http://${SOURCEIP}/git"
if [ "${SOURCEIP}" == "github.com" ]; then
    HTTPURL="https://github.com/"
fi

if curl --silent --head "${HTTPURL}" | grep -i "Content-Type: text/html; charset" >/dev/null; then

    if [ "${SOURCEIP}" == "github.com" ]; then
        $SUDO git remote set-url origin "https://github.com/FalconChristmas/fpp.git"
    else
        $SUDO git remote set-url origin "http://${SOURCEIP}/git/"
    fi
    # rev-parse gives the plain branch name (and "HEAD" for a detached checkout)
    # -- unlike "git branch | grep '^\*'" it never returns "(HEAD detached...)".
    GITBRANCH=$(cd ${FPPDIR} && $SUDO git rev-parse --abbrev-ref HEAD 2>/dev/null)

    # PR branches track origin/pull/<n>/head which is not covered by the
    # default +refs/heads/*:refs/remotes/origin/* fetch refspec. Refresh
    # it explicitly (forced) so `git rebase @{u}` sees the force-pushed
    # head rather than rebasing onto a stale frozen ref.
    if [[ "${GITBRANCH}" =~ ^pr-([0-9]+)$ ]]; then
        PR_NUM="${BASH_REMATCH[1]}"
        if [ "x${FPPDIR}" = "x/opt/fpp" ]; then
            runGitLocked "cd ${FPPDIR} && git fetch origin +pull/${PR_NUM}/head:refs/remotes/origin/pull/${PR_NUM}/head 2>&1 | head -20" || true
        else
            runGitLocked "cd ${FPPDIR} && sudo -u ${FPPUSER} git fetch origin +pull/${PR_NUM}/head:refs/remotes/origin/pull/${PR_NUM}/head 2>&1 | head -20" || true
        fi
    fi

    logStage "Fetching updates from branch ${GITBRANCH}"

    if [ "x${FPPDIR}" = "x/opt/fpp" ]
    then
        cd ${FPPDIR}
		# Fetch, then rebase onto this branch's configured upstream (@{u})
		# rather than a bare "git pull". @{u} follows whatever remote the
		# branch tracks (origin, newfeatures, a custom mirror) and, unlike a
		# rebasing pull, never consults FETCH_HEAD -- so it can't hit
		# "Cannot rebase onto multiple branches." See scripts/functions.
		runGitLocked "cd ${FPPDIR} && git fetch && git rebase @{u}"
		if [ $? -ne 0 ]; then
		  exit 1
		fi
		$SUDO git fetch --tags -f
        if [[ $(git config --list | grep -c 'safe.directory=/opt/fpp') < 1 ]]; then
            $SUDO git config --global --add safe.directory ${FPPDIR}
        fi
        
        if  [ "${FPPPLATFORM}" = "Raspberry Pi" ]; then
            if [ "${SOURCEIP}" == "github.com" ]; then
                cd ${FPPDIR} && $SUDO git submodule sync && $SUDO git submodule update --init --remote
            else
                cd ${FPPDIR} && $SUDO git config submodule.external/spixels.url http://${SOURCEIP}/git/modules/external/spixels
                cd ${FPPDIR} && $SUDO git config submodule.external/RF24.url http://${SOURCEIP}/git/modules/external/RF24
                cd ${FPPDIR} && $SUDO git config submodule.external/rpi-rgb-led-matrix.url http://${SOURCEIP}/git/modules/external/rpi-rgb-led-matrix


                cd ${FPPDIR}/external/rpi-rgb-led-matrix && $SUDO git remote set-url origin "http://${SOURCEIP}/git/modules/external/rpi-rgb-led-matrix" && $SUDO git fetch
                cd ${FPPDIR}/external/spixels && $SUDO git remote set-url origin "http://${SOURCEIP}/git/modules/external/spixels" && $SUDO git fetch
                cd ${FPPDIR}/external/RF24 && $SUDO git remote set-url origin "http://${SOURCEIP}/git/modules/external/RF24" && $SUDO git fetch
                cd ${FPPDIR}/
            fi
            cd ${FPPDIR}/ && $SUDO git submodule update --init
        fi
    else
        cd ${FPPDIR}
		runGitLocked "cd ${FPPDIR} && sudo -u ${FPPUSER} git fetch && sudo -u ${FPPUSER} git rebase @{u}"
		if [ $? -ne 0 ]; then
		  exit 1
		fi
		sudo -u ${FPPUSER} git fetch --tags -f
        if  [ "${FPPPLATFORM}" = "Raspberry Pi" ]; then
            cd ${FPPDIR} && sudo -u ${FPPUSER} git submodule sync && sudo -u ${FPPUSER} git submodule update --init
        fi
    fi
    $SUDO ${SCRIPTDIR}/upgrade_config
    logStage "Building FPP (longest step, please wait)"
    compileBinaries
else
    echo "Can not access ${HTTPURL}, unable to pull git updates.  Check if you have Internet Access from this FPP by going to Help->System Health Check"

    if [ ! -x ${FPPBINDIR}/fppd ]; then
        echo "${FPPBINDIR}/fppd doesn't exist, need to build it"
        logStage "Building FPP (longest step, please wait)"
        compileBinaries
    fi
fi
