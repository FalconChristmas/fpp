#!/bin/bash

BINDIR=$(cd $(dirname $0) && pwd)

. ${BINDIR}/common
. ${BINDIR}/functions


if [ "x$1" = "x" ]
then
	echo "USAGE: $0 VERSION"
	exit 1
fi

# Unified upgrade logging -> logs/fpp_system_upgrades.log. This is the outermost script
# of the version-switch path, so its tee is the one that captures the nested
# upgrade_config (and anything else it shells out to) as a single run.
startUpgradeLog "fpp-upgrade" "$1"

echo "$0 Upgrading FPP version to $1"

echo "Stopping fppd"
stopFppdForRebuild

# Same safe.directory hardening as git_pull -- /opt/fpp is owned by fpp:fpp,
# so root running git via sudo (which keeps HOME=/home/fpp) trips the
# "dubious ownership" guard unless /etc/gitconfig says otherwise.
$SUDO git config --system --add safe.directory /opt/fpp 2>/dev/null || true
$SUDO git config --system --add safe.directory '*' 2>/dev/null || true

echo "Cleaning up any compiled binaries"
cleanCompiledBinaries

echo "Adding newfeatures remote if not present"
cd ${FPPDIR}
if ! git remote get-url newfeatures > /dev/null 2>&1; then
    if [ "x${FPPDIR}" = "x/opt/fpp" ]; then
        $SUDO git remote add newfeatures https://github.com/FalconChristmas/fpp-new-feature-testing.git
    else
        sudo -u ${FPPUSER} git remote add newfeatures https://github.com/FalconChristmas/fpp-new-feature-testing.git
    fi
fi

echo "Switching git branch to $1"
# Checkout the target branch, then fetch its configured upstream and rebase
# onto the tracking ref (@{u}) rather than a bare "git pull" -- the latter
# rebases off FETCH_HEAD and can abort with "Cannot rebase onto multiple
# branches." See runGitLocked in scripts/functions.
if [ "x${FPPDIR}" = "x/opt/fpp" ]
then
	runGitLocked "cd ${FPPDIR} && git submodule foreach git reset --hard && git checkout $1 && git fetch && git rebase @{u}"
    if  [ "${FPPPLATFORM}" = "Raspberry Pi" ]; then
        cd ${FPPDIR} && $SUDO git submodule sync && $SUDO git submodule update --init
    fi

    $SUDO ${SCRIPTDIR}/upgrade_config
else
	runGitLocked "cd ${FPPDIR} && sudo -u ${FPPUSER} git submodule foreach git reset --hard && sudo -u ${FPPUSER} git checkout $1 && sudo -u ${FPPUSER} git fetch && sudo -u ${FPPUSER} git rebase @{u}"
    if  [ "${FPPPLATFORM}" = "Raspberry Pi" ]; then
        cd ${FPPDIR} && sudo -u ${FPPUSER} git submodule sync && sudo -u ${FPPUSER} git submodule update --init
    fi

    sudo -u ${FPPUSER} ${SCRIPTDIR}/upgrade_config
fi


echo "Compiling Binaries"
compileBinaries

# Delete any statistics
/usr/bin/curl -X DELETE http://localhost/api/statistics/usage

# Clear the cached "what version/commit am I on" lookups so the web UI
# reflects the upgrade immediately instead of waiting out their ~20-90s TTLs
# -- this upgrade doesn't reboot, and /tmp (where those caches live) is tmpfs
# so nothing else clears them. This is a UX nicety, not a correctness fix:
# check_fppstats_updates() in www/common.php compares commit timestamps, not
# just shas, so stale remote data can no longer produce a false "update
# available" prompt on its own. Nothing here reads from GitHub's releases API
# (that's a separate, longer-lived cache about major-version upgrades, not
# this per-commit one), so it's left alone. The branch name itself
# (getFPPBranch()) isn't cached in /tmp at all -- it's a hardcoded value in
# the generated www/fppversion.php, already rewritten by compileBinaries
# above, so there's no branch cache file to clear here.
echo "Clearing cached update-check data"
rm -f /tmp/cache_local_git_version.cache /tmp/cache_local_git_commit_date.cache \
      /tmp/cache_fppstats_commits.cache

# Re-warm those caches now rather than leaving the first page load after the
# upgrade to pay for it -- fppstats_commits involves a real network call to
# fppstats.falconchristmas.com (up to ~5s on a slow/unreachable host), and
# nothing needs to see the outcome here, so this is fire-and-forget.
/usr/bin/curl -s -o /dev/null http://localhost/api/system/updateStatus &

