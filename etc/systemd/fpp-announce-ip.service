[Unit]
Description=FPP Announce IP Address
# Run after the network setup has resolved an IP and after PipeWire is up so the
# flite-rendered announcement can play. Deliberately NOT ordered before fppd:
# this is fire-and-forget so the (CPU-heavy on single-core boards) flite render
# no longer competes with the tail of fpp_postnetwork or fppd startup.
# Ordering only -- intentionally NO Wants=/Requires= on the PipeWire services.
# A Wants= here would pull them into the boot transaction even when they're
# disabled (enable/disable only controls a unit's own [Install] symlinks, not
# Wants= declared by other units), and with only After= to constrain them they'd
# start at sound.target time, before postNetwork. With After= alone, this just
# orders the announcement after whatever started PipeWire (the enabled services
# in the default config, or setupAudio starting them on demand); if PipeWire
# isn't in the transaction at all, the After= is simply ignored.
After=fpp_postnetwork.service fpp-pipewire.service fpp-wireplumber.service fpp-pipewire-pulse.service

[Service]
# Type=simple, NOT oneshot, so this is genuinely the fire-and-forget the comment
# above claims. A oneshot job keeps multi-user.target (and thus graphical.target)
# in "start waiting" until ExecStart exits -- so anything that stalls the
# announcement stalls the whole boot transaction with no upper bound. That is not
# theoretical: a duplicate WirePlumber ALSA node losing the race for the PCM left
# pw-play blocked in poll(), and the box sat at 13 minutes of "boot" and climbing
# until the process was killed by hand. Nothing is ordered after this unit, so
# there is nothing that needs to wait for it to finish.
Type=simple
# Yield to fppd/apache2/php-fpm rather than racing them. Being Type=simple this
# starts the moment postNetwork finishes, which is exactly when those three are
# coming up; measured on a single-core AM335x board the flite render spends 3.6s
# of CPU in that window, against 1.1s for apache2 over the same span. Nice only
# costs the announcement latency when something else actually wants the core, so
# on a multi-core board it changes nothing. Deliberately not deferred with an
# After= instead: the whole point of announcing an IP is to say it promptly.
Nice=19
IOSchedulingClass=idle
ExecStart=/opt/fpp/src/fppinit announceIP
# Backstop for anything that gets past the per-command timeouts in announceIP():
# the announcement is a few seconds of speech, so minutes means wedged. This only
# reaps the stray process -- with Type=simple the boot has long since moved on.
RuntimeMaxSec=180

[Install]
WantedBy=multi-user.target
