[Unit]
Description=FPPd
After=fpp_postnetwork.service
Requires=fpp_postnetwork.service
# fppd is an Avahi client, so avahi-daemon has to outlive it: systemd stops units in
# the reverse of the start order, and without this ordering it is free to stop
# avahi-daemon while fppd is still running.  dbus.service is here for the same reason
# and is the one that actually matters -- avahi-daemon exits on its own the moment the
# system bus goes away ("Disconnected from D-Bus, exiting"), so ordering against avahi
# alone still let it die seconds before fppd was told to stop.
# Wants, not Requires: no mDNS is a degraded FPP, not a broken one.
After=avahi-daemon.service dbus.service
Wants=avahi-daemon.service
Conflicts=shutdown.target
Before=shutdown.target
DefaultDependencies=no
StartLimitIntervalSec=200
StartLimitBurst=5

[Service]
Type=simple
EnvironmentFile=-/run/fppd/fpp-audio.env
ExecStart=/opt/fpp/src/fppd -f
ExecStop=/opt/fpp/scripts/fppd_stop
ExecStartPre=-/opt/fpp/src/fppinit bootPre
ExecStartPost=-/opt/fpp/src/fppinit bootPost
ExecReload=/opt/fpp/src/fpp -r
Restart=always
TimeoutStopSec=15


[Install]
WantedBy=multi-user.target
